# Empêche puppeteer (tiré par le devDep pagedjs-cli, outil LOCAL de génération
# des PDF de dossiers) de télécharger Chromium (~150 Mo) à l'install — inutile
# au build Vercel, et en local le script scripts/dossier-pdf.sh installe un
# Chrome dédié assorti via @puppeteer/browsers.
puppeteer_skip_download=true
